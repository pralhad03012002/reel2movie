# Copy to .env and fill in. Never commit .env.
# TMDB: either the v3 "API Key" or the long "API Read Access Token" works.
TMDB_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Path to the Firebase service-account JSON (keep it outside git).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Local transcription (Settings switch in the app). small.en is English-only;
# for Hindi or mixed reels use LOCAL_STT_MODEL=small and LOCAL_STT_LANGUAGE=auto.
#LOCAL_STT_MODEL=small.en
#LOCAL_STT_LANGUAGE=en
