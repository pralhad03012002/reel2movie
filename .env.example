# Copy to .env and fill in real values. Never commit .env.

# TMDB v4 "API Read Access Token" (Bearer token, not the older v3 api_key).
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Which vision backend the visual-fallback poster/frame detection step uses.
# OPTIONAL: leave blank to default to "claude_code". Valid values:
#   - claude_code (default) -- shells out to the locally-installed `claude`
#     CLI, billed against an existing Claude Pro/Max subscription instead of
#     a separate metered API key. Tradeoff: requires the `claude` CLI to be
#     installed AND logged into a Claude subscription on whatever machine
#     actually runs the pipeline -- a new environmental dependency, not just
#     a pip package.
#   - anthropic_api -- calls the Anthropic API directly (see
#     ANTHROPIC_API_KEY below). Tradeoff: needs a separate billed API key,
#     but has no CLI/subscription dependency -- just a pip package.
VISION_BACKEND=

# Anthropic API key. OPTIONAL: only needed when VISION_BACKEND=anthropic_api
# is explicitly set above; unused (and not required) when VISION_BACKEND is
# left blank or set to claude_code.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Path to an Instagram cookies file (Netscape format) for yt-dlp. OPTIONAL:
# leave blank to run with no Instagram session at all (anonymous access).
# This is free and touches no account, but Instagram increasingly blocks or
# rate-limits unauthenticated requests, so some reels may fail to fetch.
# Set this for more reliable access - see brainstorm.md's ingestion risks.
INSTAGRAM_COOKIES_FILE=
