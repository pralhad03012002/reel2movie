# Copy to .env and fill in real values. Never commit .env.

# TMDB v4 "API Read Access Token" (Bearer token, not the older v3 api_key).
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Anthropic API key, used for vision-based poster/frame detection fallback.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Path to an Instagram cookies file (Netscape format) for yt-dlp, needed for
# reliable caption/comment access. Only required for live ingestion, not for
# unit tests (which use recorded fixtures).
INSTAGRAM_COOKIES_FILE=
